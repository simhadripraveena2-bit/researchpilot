# ResearchPilot configuration. Copy to .env and adjust. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL 16 with pgvector (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://researchpilot:researchpilot@localhost:5432/researchpilot

# Local development binds to localhost only. A non-local bind requires AUTH_MODE != disabled
# (hosted deployment is blocked until gate H passes; docs/IMPLEMENTATION_ROADMAP.md §8.2).
BIND_HOST=127.0.0.1
BIND_PORT=8000
AUTH_MODE=disabled

STORAGE_DIR=./var/storage

# LLM task configuration (provisional until decision D1 is approved)
# LLM_CONFIG_PATH=backend/config/llm_tasks.yaml
ANTHROPIC_API_KEY=

# Scholarly APIs (R1)
CONTACT_EMAIL=
# Semantic Scholar API key (sent as x-api-key; never commit a real value). In a Claude Code
# cloud session the proxy injects it: set S2_API_KEY=proxy-injected there.
S2_API_KEY=
OPENALEX_API_KEY=
GITHUB_TOKEN=
HF_TOKEN=

# Integration tests: a role allowed to create databases
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
